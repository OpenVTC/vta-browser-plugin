{
  "name": "@openvtc/vti-tsp-js",
  "version": "0.1.0",
  "description": "Pure-TypeScript TSP (Trust Spanning Protocol) primitives \u2014 byte-compatible with affinidi-tsp. RFC 9180 HPKE seal/open on @noble + binary CESR framing. No WebCrypto, no WASM: runs in browsers, Node, and React Native.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hpke": {
      "types": "./dist/crypto/hpke.d.ts",
      "import": "./dist/crypto/hpke.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "tsc -b",
    "test": "tsc -b && node --test tests/*.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenVTC/vta-browser-plugin.git",
    "directory": "packages/tsp-js"
  },
  "homepage": "https://github.com/OpenVTC/vta-browser-plugin/tree/main/packages/tsp-js#readme",
  "license": "Apache-2.0",
  "devDependencies": {
    "@hpke/chacha20poly1305": "^1.8.0",
    "@hpke/core": "^1.9.0",
    "typescript": "^7.0.2"
  }
}
